Menu="Buttons:99"
Link="custom-header-logo-hook"
Title="CustomHeaderLogoHook"
---
<?php
/* Custom Header Logo - global hook.
 * Pages with Menu="Buttons" are evaluated inside <head> on every webGUI page.
 * The Link attribute prevents a visible button from being rendered in the nav bar.
 * No Unraid OS file is patched: this survives OS updates by design.
 *
 * Where the stock logo lives depends on the Unraid release:
 *   7.0 - 7.1  #header .logo > a[href="https://unraid.net"] (version is a sibling component)
 *   7.2 - 7.3  inside <unraid-header-os-version>, together with the version
 *   7.4+       inside <unraid-header> (server-rendered placeholder, then the mounted Vue app)
 * The one constant is the <a href="https://unraid.net"> wrapping the logo, so we hide
 * that link and insert ours right next to it, in the same parent. The native version
 * and update indicator stay untouched. A MutationObserver re-applies the swap when
 * the Vue header mounts or re-renders.
 * Fallback: if the header component renders in an (open) shadow root, the link is not
 * reachable, so the whole component is hidden and our logo + version is shown instead.
 */
$chl_cfg_file = '/boot/config/plugins/custom.header.logo/custom.header.logo.cfg';
$chl_cfg = is_file($chl_cfg_file) ? (parse_ini_file($chl_cfg_file) ?: []) : [];
if (($chl_cfg['SERVICE'] ?? 'disabled') === 'enabled' && !empty($chl_cfg['LOGOURL'])):
  $chl_logo   = $chl_cfg['LOGOURL'];
  $chl_link   = !empty($chl_cfg['LINKURL']) ? $chl_cfg['LINKURL'] : '/Dashboard';
  $chl_height = max(12, min(80, (int)($chl_cfg['HEIGHT'] ?? 28)));
  $chl_target = (($chl_cfg['NEWTAB'] ?? '0') === '1') ? '_blank' : '_self';
  $chl_osver  = is_file('/etc/unraid-version') ? (parse_ini_file('/etc/unraid-version') ?: []) : [];
  $chl_ver    = $chl_osver['version'] ?? '';
?>
<style>
#header a[href="https://unraid.net"]:not(#chl-logo),
#header a[href="https://unraid.net/"]:not(#chl-logo) { display: none !important; }
#header.chl-shadow unraid-header-os-version { display: none !important; }
#chl-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  max-width: 100%;
  min-width: 0;
  text-decoration: none;
  flex-shrink: 0;
}
#chl-logo img {
  height: <?=$chl_height?>px;
  width: auto;
  max-width: 100%;
  display: block;
}
#chl-logo .chl-version {
  font-size: 12px;
  color: var(--header-text-secondary, var(--inverse-text-color, #999));
  white-space: nowrap;
}
#header.chl-shadow #chl-logo { align-self: center; margin-left: 10px; }
</style>
<script>
(function() {
  var STOCK = 'a[href="https://unraid.net"]:not(#chl-logo), a[href="https://unraid.net/"]:not(#chl-logo)';
  var logo = null;

  function build() {
    var a = document.createElement('a');
    a.id = 'chl-logo';
    a.href = <?=json_encode($chl_link)?>;
    a.target = <?=json_encode($chl_target)?>;
    if (a.target === '_blank') a.rel = 'noopener noreferrer';
    var img = document.createElement('img');
    img.src = <?=json_encode($chl_logo)?>;
    img.alt = 'logo';
    a.appendChild(img);
    return a;
  }

  function setVersion(show) {
    var span = logo.querySelector('.chl-version');
    var ver = <?=json_encode($chl_ver)?>;
    if (show && ver && !span) {
      span = document.createElement('span');
      span.className = 'chl-version';
      span.textContent = 'Version: ' + ver;
      logo.appendChild(span);
    } else if (!show && span) {
      span.remove();
    }
  }

  function apply() {
    var header = document.getElementById('header');
    if (!header) return;
    if (!logo) logo = build();
    var stock = header.querySelector(STOCK);
    if (stock) {
      // Normal case: sit exactly where the stock logo is.
      header.classList.remove('chl-shadow');
      setVersion(false);
      if (stock.previousSibling !== logo) stock.parentNode.insertBefore(logo, stock);
      return;
    }
    var comp = header.querySelector('unraid-header-os-version');
    if (comp && comp.shadowRoot) {
      // Logo is unreachable inside a shadow root: hide the component, show ours + version.
      header.classList.add('chl-shadow');
      setVersion(true);
      if (comp.previousSibling !== logo) comp.parentNode.insertBefore(logo, comp);
    }
    // Otherwise the header has not rendered its logo yet: the observer will call us again.
  }

  var queued = false;
  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(function() { queued = false; apply(); });
  }

  function start() {
    var header = document.getElementById('header');
    if (!header) return;
    apply();
    new MutationObserver(schedule).observe(header, { childList: true, subtree: true });
    // Custom elements attach their shadow root without a childList mutation on #header.
    if (window.customElements) {
      customElements.whenDefined('unraid-header-os-version').then(schedule);
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
<?php endif; ?>
