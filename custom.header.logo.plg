<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "custom.header.logo">
<!ENTITY author    "Gilles Reichert">
<!ENTITY version   "2026.11.20">
<!ENTITY launch    "Settings/CustomHeaderLogo">
<!ENTITY gitURL    "https://raw.githubusercontent.com/snarkbe/unraid-custom-header-logo/main">
<!ENTITY pluginURL "&gitURL;/custom.header.logo.plg">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
<!-- MD5 of the downloaded files: keep in sync with ./update-md5.sh after any change -->
<!ENTITY md5page   "049cf1b28b23f7c3cf831fd217909a8c">
<!ENTITY md5logo   "e47302e60345b4a927e6ef123b6d7f51">
<!ENTITY md5hook   "f47c96c9d795e96ee2e3910d58e466b5">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        support="https://forums.unraid.net/"
        icon="image"
        min="7.0.0">

<CHANGES>
###2026.11.20
- Fix: works on Unraid 7.0 to 7.4. The stock logo link is now targeted directly instead of the
  version component, which no longer holds the logo on 7.0/7.1 and no longer exists on 7.4.
- The custom logo takes the exact place of the stock one; the native version and update
  indicator are kept, so the "Keep version text" option was removed.
- Fix: plugin updates now really replace the installed files (old files are removed first,
  downloads are MD5-checked).
- Files are cached on the flash drive: the plugin installs at boot without network access.
- New: leave the image URL empty to use logo.svg/png/webp/jpg/gif stored in
  /boot/config/plugins/custom.header.logo/ (survives reboots and updates).

###2026.06.10
- Initial release.
- Replace the Unraid logo in the top banner with a custom image.
- Configure the URL the logo points to.
- Adjustable logo height, optional new-tab behavior, optional version text.
- No Unraid OS files are patched: uses the webGUI Buttons page hook, survives OS updates.
</CHANGES>

<!--
Custom Header Logo
Replaces the Unraid logo in the top banner (and the link it points to)
with a user-defined image and URL.

How it works:
- Settings page under Settings > User Preferences > Custom Header Logo.
- Config stored at &flash;/custom.header.logo.cfg (persists on flash).
- A hidden Menu="Buttons" page is evaluated in the head of every webGUI page;
  it hides the stock <a href="https://unraid.net"> logo link in the #header
  banner and inserts a custom <a><img></a> in its place.
- Nothing under /usr/local/emhttp outside this plugin folder is modified.

Install flow:
- The plugin manager never overwrites an existing file, so the RAM copy is wiped first.
- Page files are downloaded to the flash drive (MD5-checked: re-downloaded only when
  they change), then copied into the webGUI. At boot they come from flash, no network needed.
-->

<!-- Pre-install: remove the previous RAM copy so an update replaces every file -->
<FILE Run="/bin/bash">
<INLINE>
rm -rf &emhttp;
</INLINE>
</FILE>

<!-- Settings page (cached on flash) -->
<FILE Name="&flash;/CustomHeaderLogo.page">
<URL>&gitURL;/CustomHeaderLogo.page</URL>
<MD5>&md5page;</MD5>
</FILE>

<!-- Global hook page, evaluated on every webGUI page, renders no visible button (cached on flash) -->
<FILE Name="&flash;/CustomHeaderLogoHook.page">
<URL>&gitURL;/CustomHeaderLogoHook.page</URL>
<MD5>&md5hook;</MD5>
</FILE>

<!-- Serves the logo stored on flash (cached on flash) -->
<FILE Name="&flash;/logo.php">
<URL>&gitURL;/logo.php</URL>
<MD5>&md5logo;</MD5>
</FILE>

<!-- README shown by the plugin manager -->
<FILE Name="&emhttp;/README.md">
<INLINE>
<![CDATA[
**Custom Header Logo**

Replace the Unraid logo in the top banner with your own image and choose the URL it links to. Configure it under Settings > User Preferences > Custom Header Logo. Suggested image size: 320x56 px (PNG/SVG, transparent background), displayed at 160x28 px like the stock logo.
]]>
</INLINE>
</FILE>

<!-- Post-install: copy pages into the webGUI, create default config on flash if missing -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
FLASH="/boot/config/plugins/custom.header.logo"
EMHTTP="/usr/local/emhttp/plugins/custom.header.logo"
CFG="$FLASH/custom.header.logo.cfg"
mkdir -p "$FLASH" "$EMHTTP"
cp -f "$FLASH/CustomHeaderLogo.page" "$FLASH/CustomHeaderLogoHook.page" "$FLASH/logo.php" "$EMHTTP/" || exit 1
if [ ! -f "$CFG" ]; then
  cat > "$CFG" <<'EOF'
SERVICE="disabled"
LOGOURL=""
LINKURL=""
HEIGHT="28"
NEWTAB="0"
EOF
fi
echo ""
echo "----------------------------------------------------"
echo " custom.header.logo has been installed."
echo " Configure it: Settings > User Preferences"
echo "               > Custom Header Logo"
echo " Suggested logo size: 320x56 px (shown at 160x28)"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/custom.header.logo
rm -rf /boot/config/plugins/custom.header.logo
echo "custom.header.logo removed. Refresh the webGUI to restore the stock logo."
]]>
</INLINE>
</FILE>

</PLUGIN>
