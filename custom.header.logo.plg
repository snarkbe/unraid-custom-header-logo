<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "custom.header.logo">
<!ENTITY author    "Gilles Reichert">
<!ENTITY version   "2026.06.10">
<!ENTITY launch    "Settings/CustomHeaderLogo">
<!ENTITY gitURL    "https://raw.githubusercontent.com/snarkbe/unraid-custom-header-logo/main">
<!ENTITY pluginURL "&gitURL;/custom.header.logo.plg">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        support="https://forums.unraid.net/"
        icon="image"
        min="7.0.0">

<CHANGES>
###2026.06.10
- Initial release.
- Replace the Unraid logo in the top banner with a custom image.
- Configure the URL the logo points to.
- Adjustable logo height, optional new-tab behavior, optional version text.
- No Unraid OS files are patched: uses the webGUI Buttons page hook, survives OS updates.
</CHANGES>

<!--
Custom Header Logo
Replaces the Unraid logo in the top banner (and the link it points to)
with a user-defined image and URL.

How it works:
- Settings page under Settings > User Preferences > Custom Header Logo.
- Config stored at &flash;/custom.header.logo.cfg (persists on flash).
- A hidden Menu="Buttons" page is evaluated in the head of every webGUI page;
  it hides the stock <unraid-header-os-version> web component and inserts a
  custom <a><img></a> at the left of the #header banner.
- Nothing under /usr/local/emhttp outside this plugin folder is modified.
-->

<!-- Settings page -->
<FILE Name="&emhttp;/CustomHeaderLogo.page">
<URL>&gitURL;/CustomHeaderLogo.page</URL>
</FILE>

<!-- Global hook page (evaluated on every webGUI page, renders no visible button) -->
<FILE Name="&emhttp;/CustomHeaderLogoHook.page">
<URL>&gitURL;/CustomHeaderLogoHook.page</URL>
</FILE>

<!-- README shown by the plugin manager -->
<FILE Name="&emhttp;/README.md">
<INLINE>
<![CDATA[
**Custom Header Logo**

Replace the Unraid logo in the top banner with your own image and choose the URL it links to. Configure it under Settings > User Preferences > Custom Header Logo. Suggested image size: 320x56 px (PNG/SVG, transparent background), displayed at 160x28 px like the stock logo.
]]>
</INLINE>
</FILE>

<!-- Post-install: create default config on flash if missing -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
CFG_DIR="/boot/config/plugins/custom.header.logo"
CFG="$CFG_DIR/custom.header.logo.cfg"
mkdir -p "$CFG_DIR"
if [ ! -f "$CFG" ]; then
  cat > "$CFG" <<'EOF'
SERVICE="disabled"
LOGOURL=""
LINKURL=""
HEIGHT="28"
NEWTAB="0"
SHOWVERSION="1"
EOF
fi
echo ""
echo "----------------------------------------------------"
echo " custom.header.logo has been installed."
echo " Configure it: Settings > User Preferences"
echo "               > Custom Header Logo"
echo " Suggested logo size: 320x56 px (shown at 160x28)"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/custom.header.logo
rm -rf /boot/config/plugins/custom.header.logo
echo "custom.header.logo removed. Refresh the webGUI to restore the stock logo."
]]>
</INLINE>
</FILE>

</PLUGIN>
